+  int live = 0;
 
   /* for dying/unconfirmed conntrack tuples, an IPCT_DESTROY event may NOT be fired.
-   * so we manually kill one of those tuples once we acquire one. */
-
-  list_for_each_safe(iter, tmp, &mapping->original_tuple_list) {
-    original_tuple_item = list_entry(iter, struct nat_mapping_original_tuple, node);
+   * so we manually kill one of those tuples once we acquire one.
+   * The oldest tuples are at the tail: dead ones are freed as found (each tuple is
+   * freed once, so this is paid for by its insertion), live ones are rotated to the
+   * head, and the scan stops after CHECK_MAPPING_LIVE_PROBES live ones. */
+
+  while (!list_empty(&mapping->original_tuple_list) &&
+         live < CHECK_MAPPING_LIVE_PROBES && live < mapping->refer_count) {
+    original_tuple_item = list_last_entry(&mapping->original_tuple_list, struct nat_mapping_original_tuple, node);
 
     tuple_hash = nf_conntrack_find_get(net, zone, &original_tuple_item->tuple);
 
