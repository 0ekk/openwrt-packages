+static int fullconenat_tg_check(const struct xt_tgchk_param *par)
+{
+  const struct nf_nat_ipv4_multi_range_compat *mr = par->targinfo;
+
+  if (mr->rangesize != 1) {
+    pr_info_ratelimited("xt_FULLCONENAT: rejected rangesize %u != 1\n", mr->rangesize);
+    return -EINVAL;
+  }
+
+  if ((mr->range[0].flags & NF_NAT_RANGE_MAP_IPS) &&
+      ntohl(mr->range[0].min_ip) > ntohl(mr->range[0].max_ip)) {
+    pr_info_ratelimited("xt_FULLCONENAT: rejected inverted IP range\n");
+    return -EINVAL;
+  }
+
+  if (mr->range[0].flags & NF_NAT_RANGE_PROTO_SPECIFIED) {
+    uint16_t pmin = be16_to_cpu(mr->range[0].min.udp.port);
+    uint16_t pmax = be16_to_cpu(mr->range[0].max.udp.port);
+    if (pmin == 0 || pmax < pmin) {
+      pr_info_ratelimited("xt_FULLCONENAT: rejected invalid port range %u-%u\n", pmin, pmax);
+      return -EINVAL;
+    }
+  }
+
+  return fullconenat_tg_check_common(par);
