+  if ((range->flags & NF_NAT_RANGE_MAP_IPS) &&
+      ipv6_addr_cmp(&range->min_addr.in6, &range->max_addr.in6) > 0) {
+    pr_info_ratelimited("xt_FULLCONENAT: rejected inverted IPv6 range\n");
+    return -EINVAL;
+  }
+
+  if (range->flags & NF_NAT_RANGE_PROTO_SPECIFIED) {
+    uint16_t pmin = be16_to_cpu(range->min_proto.udp.port);
+    uint16_t pmax = be16_to_cpu(range->max_proto.udp.port);
+    if (pmin == 0 || pmax < pmin) {
+      pr_info_ratelimited("xt_FULLCONENAT: rejected invalid IPv6 port range %u-%u\n", pmin, pmax);
+      return -EINVAL;
+    }
+  }
+
+  return fullconenat_tg_check_common(par);
