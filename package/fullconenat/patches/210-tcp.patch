+/* protocols the IPv4 target maps. Ports are read through the u.udp.port union
+ * member for both: it aliases u.tcp.port and u.all (same 16 bits). */
+static inline int is_fullcone_proto(const uint8_t protonum) {
+  return protonum == IPPROTO_UDP || protonum == IPPROTO_TCP;
