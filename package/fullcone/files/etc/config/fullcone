config fullcone 'main'
	option enabled '0'
	# Also TCP: inbound TCP to a port a LAN host connected from reaches that host
	option tcp '0'
	# Also IPv6, only where fw4 masquerades it (masq6 on the wan zone, NAT66)
	option ipv6 '0'
	# Empty: derived from network.lan / network.wan
	option lan_subnet ''
	option wan_device ''
	# Empty: network.globals.ula_prefix
	option lan6_subnet ''
	# Inbound ports (UDP, and TCP with option tcp) kept for VPN / remote-access services on the router itself
	list exclude_port '41641'
	list exclude_port '51820'
	list exclude_port '9993'
	list exclude_port '32448'
	list exclude_port '21116'
