# Official OpenWrt SDK for one release and target; build.sh sources this file.
REL=25.12.5
TARGET=x86/64
SDK=openwrt-sdk-25.12.5-x86-64_gcc-14.3.0_musl.Linux-x86_64
# From https://downloads.openwrt.org/releases/25.12.5/targets/x86/64/sha256sums
SDK_SHA256=0c8df0151a1e88feb7c03d694d61f6a18d51872815b7c811d76e2b77504d5e9c
# Base feed commit from the SDK's feeds.conf.default (provides build dependencies such as iptables).
BASE_REV=f0a60eee2fe051741c643ea6118718aae1ef17fb
# Every kmod must depend on exactly this kernel (the "kernel=" line in /etc/apk/world on the router).
KERNEL_PIN=6.12.94~a7bc15f451f9652701ba04af9cfb0b95-r1
